{
  "manifest_version": 3,
  "name": "Website Copilot",
  "version": "0.1.0",
  "description": "在任何網站右下角浮出網站助理（本機開發模式，localhost:8000）",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["widget.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
