# 複製為 .env 後填入金鑰：cp .env.example .env
# 各模組依設定檔中的模型名稱（gpt-* / gemini-*）選用對應的金鑰。

# OpenAI：embedding（text-embedding-3-*）、gpt-* 的 RAG query / evaluator / agent / VLM
OPENAI_API_KEY=

# Gemini：RAG query engine 與 agent（gemini-*）
GEMINI_RAG_QUERY_ENGINE_API_KEY=
# Gemini：RAG evaluator（gemini-*）
GEMINI_RAG_EVALUATOR_API_KEY=
# Gemini：網頁圖片摘要 VLM（gemini-*）
GEMINI_WEBPAGE_IMAGE_SUMMARIZER_VLM_API_KEY=
